# ==============================================================================
# SECUREDOC PIPELINE — CONFIGURATION TEMPLATE
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & GENERAL SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=securedoc_user
POSTGRES_PASSWORD=securedoc_secure_password_2026
POSTGRES_DB=securedoc_pipeline
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://securedoc_user:securedoc_secure_password_2026@localhost:5432/securedoc_pipeline

# ------------------------------------------------------------------------------
# REDIS & CELERY WORKER BROKER
# ------------------------------------------------------------------------------
REDIS_PASSWORD=securedoc_redis_pass_2026
REDIS_PORT=6379
REDIS_URL=redis://:securedoc_redis_pass_2026@localhost:6379/0
CELERY_BROKER_URL=redis://:securedoc_redis_pass_2026@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:securedoc_redis_pass_2026@localhost:6379/2

# ------------------------------------------------------------------------------
# AUTHENTICATION & CRYPTOGRAPHY (JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=securedoc_super_secret_jwt_key_pipeline_2026_xyz98124
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# DOOR 1: ANTIVIRUS & FORMAT ENFORCEMENT
# ------------------------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
MAX_FILE_SIZE_BYTES=20971520 # 20 Megabytes
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff

# ------------------------------------------------------------------------------
# FILE SYSTEM & QUARANTINE STORAGE
# ------------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
QUARANTINE_DIR=./data/quarantine

# ------------------------------------------------------------------------------
# DOOR 3: AI VISION & MULTIMODAL EXTRACTION
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
PROMPT_INJECTION_DEFENSE_ENABLED=true

# ------------------------------------------------------------------------------
# DOOR 4: THREE-WAY MATCHING & RISK POLICIES
# ------------------------------------------------------------------------------
MATCH_VARIANCE_TOLERANCE_PERCENT=1.0
STP_AUTO_APPROVAL_THRESHOLD=95.0
BANK_ACCOUNT_VERIFICATION_STRICT=true

# ------------------------------------------------------------------------------
# FRONTEND & CORS SETTINGS
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80
